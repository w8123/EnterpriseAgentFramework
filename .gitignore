# ============================================
# Enterprise Agent Framework - Unified .gitignore
# ============================================

# ---- Compiled / Build ----
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
*.pid
target/
tmp/
.codex-logs/
logs/

# ---- Python cache ----
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# ---- JVM crash logs ----
hs_err_pid*
replay_pid*

# ---- IDE ----
.idea/
*.iml
.vscode/
.worktrees/
.classpath
.project
.settings/
.factorypath
.springBeans

# Shared IntelliJ run configs for the five ReachAI services are intentionally tracked.
# Keep .run/ out of this ignore list.

# ---- AI / Local Assistant Tooling ----
.claude/
.mimocode/
.playwright-cli/
.superpowers/
.cursor/*
!.cursor/
!.cursor/rules/
!.cursor/rules/**
.cursor/playwright-output/
.cursor/mcp.json
.cursor/dbhub-ai-mysql.toml

# ---- Frontend (ai-admin-front) ----
ai-admin-front/node_modules/
ai-admin-front/dist/
ai-admin-front/dist-sdk/
ai-admin-front/.vite/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Environment / Secrets ----
.env
.env.local
# 本机配置和 dev.sh 的运行目录（含自动生成的密钥）
reachai.env
.reachai/
.env.*.local
**/application-local.yml
**/application-secret.yml
ai-admin-front/nul

# ---- Local UI prototypes ----
prototypes/

# ---- Local test and QA output ----
output/
_runtime/
.codex-tmp/
.tmp-*
.local-e2e-logs/
*.err
.codex-diagnose-*.mjs

# ---- Root-level local design QA artifacts ----
/agent-debug-*.png
/ai-coding-access-overview.png
/design-qa.md

OtherOutstandingProjects/

# ---- Local runtime data (knowledge artifacts etc.) ----
/data/

# Open-source export exclusions (managed by sync-open-source.mjs).
/reachai-website/
