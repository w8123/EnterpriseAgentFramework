# ReachAI 配置文件。复制成 reachai.env 后按需修改（reachai.env 不会提交到 Git）。
#
# 5 个服务启动时都会自动读取它，按下面的顺序找第一个存在的文件：
#   REACHAI_CONFIG_FILE 指定的文件 → 当前目录或上一级的 reachai.env → REACHAI_HOME 里的 reachai.env。
# 同名的系统环境变量优先于这里的值。
#
# 新环境不需要手动建表，也不需要准备密钥：
#   - 数据库是空的时候，第一个启动的服务会自动建好表和初始数据；
#   - 首次启动会在 REACHAI_HOME（默认 ~/.reachai）生成本机密钥 secrets.properties，之后一直复用。
#     请把它和数据库一起备份，丢了以后已保存的模型密钥等就解不开了。
# 本地开发直接运行 ./dev.sh（Windows 用 .\dev.ps1），它会生成这个文件并用 Docker 启动 MySQL。

# ======================== 需要你填的 ========================

# 数据库。用 dev.sh 自带的 MySQL 时会自动生成密码，不用改。
AI_MYSQL_HOST=localhost
AI_MYSQL_PORT=3306
AI_MYSQL_DATABASE=reach_ai
AI_MYSQL_USER=reach_ai
AI_MYSQL_PASSWORD=

# 管理员 admin 首次登录的密码。只在数据库里还没有这个账号时生效；对外部署前请改掉。
REACHAI_BOOTSTRAP_ADMIN_PASSWORD=admin123

# ======================== 按需开启（不填就不用装） ========================

# 浏览器访问 ReachAI 的地址。员工把 Codex / Claude Code 连到 ReachAI 时要用；不在本机访问时改成实际域名。
# REACHAI_MCP_HUB_PUBLIC_BASE_URL=http://localhost:5200

# Milvus：只有知识库向量检索需要。没装也能启动，用到时页面会提示。
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# Docling：知识库解析 PDF、Word、PPT、Excel、图片。没装时只能导入 txt / md / csv。
# REACHAI_DOCLING_BASE_URL=http://localhost:5001

# ======================== 一般不用改 ========================

# 自定义数据目录（生成的密钥放在这里）。5 个服务必须用同一个目录。
# REACHAI_HOME=/var/lib/reachai

# 下面这些不填时自动生成，只在要沿用已有密钥或集中管理密钥时才需要填写：
# REACHAI_INTERNAL_SERVICE_SECRET=
# MODEL_CREDENTIAL_SECRET=
# AGENT_WORKFLOW_CREDENTIAL_SECRET=
# EAF_EMBED_TOKEN_SECRET=
# REACHAI_AI_CODING_TASK_SECRET_PEPPER=
# REACHAI_PERSONAL_MEMORY_INDEX_IDENTITY_SECRET=

# 平台 AI 业务写入审批需要单独配置；Base64 值必须来自安全生成的 32 字节密钥，不自动生成。
# REACHAI_PLATFORM_AI_APPROVAL_KEY_ID=
# REACHAI_PLATFORM_AI_APPROVAL_KEY_BASE64=

# 服务之间的地址：都在本机运行时不用填；Docker / 分机部署时按实际地址填写。
# MODEL_SERVICE_URL=http://localhost:18601
# KNOWLEDGE_SERVICE_URL=http://localhost:18602
# CONTROL_SERVICE_URL=http://localhost:18603
# RUNTIME_SERVICE_URL=http://localhost:18604
# CAPABILITY_SERVICE_URL=http://localhost:18605

# dev.sh 用 Docker 启动的 MySQL 的 root 密码（自动生成）。
REACHAI_MYSQL_ROOT_PASSWORD=
