@@ -0,0 +1,26 @@
+import { shallowRef } from 'vue'
+
+export interface ReachAiPageBinding {
+  pageKey: string
+  name: string
+  route: string
+  registerActions: (bridge: ReachAiPageBridge) => void
+}
+
+export interface ReachAiPageBridge {
+  registerAction: (
+    key: string,
+    handler: (args: Record<string, unknown>) => unknown | Promise<unknown>,
+    options?: Record<string, unknown>
+  ) => () => void
+}
+
+// Only the currently mounted business page may supply actions to the chat.
+export const activeReachAiPage = shallowRef<ReachAiPageBinding | null>(null)
+
+export function activateReachAiPage(binding: ReachAiPageBinding): () => void {
+  activeReachAiPage.value = binding
+  return () => {
+    if (activeReachAiPage.value === binding) activeReachAiPage.value = null
+  }
+}
diff --git a/scripts/test-reachai-product-query.cjs b/scripts/test-reachai-product-query.cjs
new file mode 100644
index 0000000..e87381b
--- /dev/null
+++ b/scripts/test-reachai-product-query.cjs
@@ -0,0 +1,79 @@
+const assert = require('node:assert/strict')
+const fs = require('node:fs')
+const vm = require('node:vm')
+const ts = require('typescript')
+
+const source = fs.readFileSync('src/views/erp/product/product/index.vue', 'utf8')
+const begin = source.indexOf('let deactivateReachAiPage:')
+const end = source.indexOf('/** 搜索按钮操作 */', begin)
+assert.ok(begin >= 0 && end > begin, 'product page test boundaries are missing')
+const excerpt = source.slice(begin, end)
+const compiled = ts.transpileModule(excerpt, { compilerOptions: { target: ts.ScriptTarget.ES2020 } }).outputText
+const calls = []
+let action
+let deactivate
+const params = { pageNo: 1, pageSize: 10, name: undefined, categoryId: undefined }
+const list = { value: [] }
+const total = { value: 0 }
+const loading = { value: false }
+const ctx = {
+  queryParams: params, list, total, loading,
+  ProductApi: { getProductPage: (query) => new Promise((resolve, reject) => calls.push({ query, resolve, reject })) },
+  activateReachAiPage: (binding) => {
+    binding.registerActions({ registerAction: (_key, handler) => { action = handler } })
+    return () => {}
+  },
+  onMounted: (fn) => fn(), onActivated: () => {}, onDeactivated: (fn) => { deactivate = fn }, onBeforeUnmount: () => {}
+}
+vm.runInNewContext(`${compiled}\nglobalThis.runProductQuery = getList`, ctx)
+
+async function main() {
+  const first = action({ name: 'old' })
+  params.name = 'new'
+  const second = ctx.runProductQuery()
+  assert.equal(calls[0].query.name, 'old')
+  assert.equal(calls[1].query.name, 'new')
+  calls[1].resolve({ list: ['new-result'], total: 1 })
+  assert.equal(await second, true)
+  calls[0].resolve({ list: ['old-result'], total: 99 })
+  const oldResult = await first
+  assert.equal(oldResult.status, 'PRECONDITION_FAILED')
+  assert.equal(list.value[0], 'new-result')
+  assert.equal(total.value, 1)
+  assert.equal(loading.value, false)
+
+  const staleByEdit = action({ name: 'edited-before-return' })
+  params.name = 'unsent-new-filter'
+  calls[2].resolve({ list: ['stale'], total: 5 })
+  assert.equal((await staleByEdit).status, 'PRECONDITION_FAILED')
+  assert.equal(list.value[0], 'new-result')
+
+  const latest = action({ name: 'current' })
+  calls[3].resolve({ list: ['current-result'], total: 2 })
+  assert.equal((await latest).status, 'SUCCESS')
+  assert.equal(list.value[0], 'current-result')
+  assert.equal(total.value, 2)
+  const leaving = action({ name: 'leaving' })
+  deactivate()
+  calls[4].resolve({ list: ['abandoned-result'], total: 7 })
+  assert.equal((await leaving).status, 'PRECONDITION_FAILED')
+  assert.equal(list.value[0], 'current-result')
+  assert.equal(loading.value, false)
+
+  const older = ctx.runProductQuery()
+  params.name = 'newest'
+  const newer = ctx.runProductQuery()
+  calls[5].resolve({ list: ['outdated'], total: 9 })
+  assert.equal(await older, false)
+  assert.equal(loading.value, true)
+  calls[6].resolve({ list: ['newest'], total: 3 })
+  assert.equal(await newer, true)
+  assert.equal(loading.value, false)
+  const failed = action({ name: 'error' })
+  calls[7].reject(new Error('network failed'))
+  await assert.rejects(failed, /network failed/)
+  assert.equal(list.value[0], 'newest')
+  assert.equal(loading.value, false)
+  console.log('ReachAI product query concurrency passed')
+}
+main().catch((error) => { console.error(error); process.exitCode = 1 })
