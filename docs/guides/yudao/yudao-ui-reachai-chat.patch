diff --git a/scripts/test-reachai-token-refresh.cjs b/scripts/test-reachai-token-refresh.cjs
new file mode 100644
index 0000000..865caa0
--- /dev/null
+++ b/scripts/test-reachai-token-refresh.cjs
@@ -0,0 +1,154 @@
+const fs = require('node:fs')
+const vm = require('node:vm')
+const assert = require('node:assert/strict')
+const ts = require('typescript')
+
+const source = fs.readFileSync('src/config/axios/service.ts', 'utf8').replaceAll('import.meta.env', 'testEnv')
+const compiled = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, esModuleInterop: true } }).outputText
+let responseHandler
+let currentToken = 'old'
+let currentRefreshToken = 'refresh'
+let refreshCalls = 0
+let resolveRefresh
+let rejectRefresh
+let tokenWrites = 0
+const replayed = []
+const instance = config => { replayed.push(config); return Promise.resolve({ token: 'embed-token' }) }
+instance.interceptors = { request: { use() {} }, response: { use(handler) { responseHandler = handler } } }
+const axios = {
+  create: () => instance,
+  defaults: { headers: { common: {} } },
+  post: () => { refreshCalls++; return new Promise((resolve, reject) => { resolveRefresh = resolve; rejectRefresh = reject }) }
+}
+const mocks = {
+  axios,
+  'element-plus': { ElMessage: { error() {} }, ElMessageBox: {}, ElNotification: { error() {} } },
+  qs: { stringify() {} },
+  '@/config/axios/config': { config: { result_code: 200, base_url: '/admin-api', request_timeout: 1000 } },
+  '@/utils/auth': {
+    getAccessToken: () => currentToken,
+    getRefreshToken: () => currentRefreshToken,
+    getTenantId: () => '1',
+    getVisitTenantId: () => null,
+    setToken: () => { tokenWrites++; currentToken = 'new' },
+    removeToken() {}
+  },
+  './errorCode': { default: 'error' },
+  '@/router': { resetRouter() {} },
+  '@/hooks/web/useCache': { deleteUserCache() {} },
+  '@/utils/encrypt': { ApiEncrypt: { getEncryptHeader: () => 'x-encrypted' } }
+}
+const context = {
+  exports: {},
+  require(id) { if (!(id in mocks)) throw Error(id); return mocks[id] },
+  testEnv: {},
+  useI18n: () => ({ t: key => key }),
+  console,
+  Promise,
+  window: { location: { href: 'http://localhost/login' } }
+}
+vm.runInNewContext(compiled, context)
+const unauthorized = () => ({ status: 401, data: { message: 'login required' }, headers: {}, request: {}, config: { headers: {} } })
+async function main() {
+  const first = responseHandler(unauthorized())
+  const encryptedRequest = unauthorized()
+  encryptedRequest.config.headers.isEncrypt = true
+  const second = responseHandler(encryptedRequest)
+  assert.equal(refreshCalls, 1, 'concurrent broker calls share a single refresh')
+  resolveRefresh({ data: { code: 0, data: { accessToken: 'new', refreshToken: 'next' } } })
+  await Promise.all([first, second])
+  assert.equal(replayed.length, 2)
+  assert.ok(replayed.every(request => request.headers.Authorization === 'Bearer new'))
+  assert.equal(replayed.find(request => request.headers.isEncrypt).headers.isEncrypted, true,
+    'queued encrypted requests are not encrypted a second time')
+  const ordinary = await responseHandler({ status: 200, data: { token: 'embed-token' }, headers: {}, request: {}, config: { headers: {} } })
+  assert.equal(ordinary.token, 'embed-token')
+  currentRefreshToken = ''
+  await responseHandler(unauthorized())
+  await Promise.race([
+    responseHandler(unauthorized()),
+    new Promise((_, reject) => setTimeout(() => reject(new Error('second 401 remains stuck in refresh queue')), 200))
+  ])
+  currentRefreshToken = 'refresh'
+  const afterLogin = responseHandler(unauthorized())
+  assert.equal(refreshCalls, 2, 'a later login can start a new refresh')
+  resolveRefresh({ data: { code: 0, data: { accessToken: 'new', refreshToken: 'next' } } })
+  await afterLogin
+  const beforeFailure = replayed.length
+  const failedRefresh = responseHandler(unauthorized())
+  const waiting = responseHandler(unauthorized())
+  const waitingRejected = assert.rejects(waiting, /refresh unavailable/)
+  rejectRefresh(new Error('refresh unavailable'))
+  await Promise.all([failedRefresh, waitingRejected])
+  assert.equal(replayed.length, beforeFailure, 'refresh failure must not replay queued requests with stale credentials')
+  const recovered = responseHandler(unauthorized())
+  assert.equal(refreshCalls, 4, 'refresh failure must release the queue for a later attempt')
+  resolveRefresh({ data: { code: 0, data: { accessToken: 'new', refreshToken: 'next' } } })
+  await recovered
+  for (const body of [
+    { code: 401, msg: 'expired', data: { accessToken: 'invalid', refreshToken: 'invalid' } },
+    { code: 0, data: { accessToken: 'new', refreshToken: '' } }
+  ]) {
+    const beforeWrites = tokenWrites
+    const beforeReplays = replayed.length
+    const refresh = responseHandler(unauthorized())
+    const queued = responseHandler(unauthorized())
+    const rejected = assert.rejects(queued, /refresh response invalid/)
+    resolveRefresh({ data: body })
+    await Promise.all([refresh, rejected])
+    assert.equal(tokenWrites, beforeWrites)
+    assert.equal(replayed.length, beforeReplays)
+  }
+  for (const nextSession of ['', 'different-session']) {
+    currentRefreshToken = 'old-session'
+    currentToken = 'old-user'
+    const beforeWrites = tokenWrites
+    const beforeReplays = replayed.length
+    const original = responseHandler(unauthorized())
+    const queued = responseHandler(unauthorized())
+    const originalRejected = assert.rejects(original, /login session changed/)
+    const queuedRejected = assert.rejects(queued, /login session changed/)
+    currentRefreshToken = nextSession
+    currentToken = nextSession ? 'new-user' : ''
+    resolveRefresh({ data: { code: 0, data: { accessToken: 'old-returned', refreshToken: 'old-session' } } })
+    await Promise.all([originalRejected, queuedRejected])
+    assert.equal(tokenWrites, beforeWrites, 'old refresh must not replace the new login')
+    assert.equal(replayed.length, beforeReplays, 'old requests must not run as the new user')
+    assert.equal(currentToken, nextSession ? 'new-user' : '')
+  }
+  const oldResponse = unauthorized()
+  oldResponse.config.headers.Authorization = 'Bearer old-user'
+  const beforeLateCalls = refreshCalls
+  const beforeLateReplays = replayed.length
+  await assert.rejects(responseHandler(oldResponse), /login session changed before response/)
+  assert.equal(refreshCalls, beforeLateCalls)
+  assert.equal(replayed.length, beforeLateReplays)
+  currentRefreshToken = 'old-session'
+  currentToken = 'old-user'
+  const failedOld = responseHandler(unauthorized())
+  const failedOldRejected = assert.rejects(failedOld, /login session changed/)
+  currentRefreshToken = 'different-session'
+  currentToken = 'new-user'
+  rejectRefresh(new Error('refresh unavailable'))
+  await failedOldRejected
+  assert.equal(currentToken, 'new-user')
+  const vue = require('vue/compiler-sfc').parse(fs.readFileSync('src/layout/components/ReachAiChat/index.vue', 'utf8'))
+  const setup = vue.descriptor.scriptSetup.content
+  const tokenSource = setup.slice(setup.indexOf('const fetchToken ='), setup.indexOf('const mountChat ='))
+  const tokenJs = ts.transpileModule(tokenSource + '\nexports.fetchToken = fetchToken', {
+    compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2020 }
+  }).outputText
+  let requestOptions
+  const tokenContext = { exports: {}, tokenUrl: '/reachai/embed/token', agentId: 'agent',
+    service: options => { requestOptions = options; return Promise.resolve({ token: 'embed', expiresIn: 25 }) } }
+  vm.runInNewContext(tokenJs, tokenContext)
+  const signal = new AbortController().signal
+  const result = await tokenContext.exports.fetchToken({ signal, pageKey: 'page' })
+  assert.equal(result.token, 'embed')
+  assert.equal(requestOptions.signal, signal)
+  assert.equal(requestOptions.validateStatus(401), true)
+  assert.equal(requestOptions.validateStatus(403), false)
+  assert.equal(requestOptions.data.pageKey, 'page')
+  console.log('ReachAI broker refresh: concurrent 401 and success cases passed')
+}
+main().catch(error => { console.error(error); process.exitCode = 1 })
diff --git a/src/layout/components/ReachAiChat/index.vue b/src/layout/components/ReachAiChat/index.vue
new file mode 100644
index 0000000..edb9e82
--- /dev/null
+++ b/src/layout/components/ReachAiChat/index.vue
@@ -0,0 +1,146 @@
+<script lang="ts" setup>
+/**
+ * ReachAI 嵌入式对话：登录后在右下角挂一个对话入口。
+ * 脚本由 ReachAI 站点提供（/sdk/embed-chat/），芋道不打包 SDK；
+ * 令牌由芋道后端 POST /reachai/embed/token 用当前登录用户换取，浏览器不接触项目密钥。
+ * 未配置 VITE_REACHAI_BASE_URL / VITE_REACHAI_AGENT_ID 时不加载。
+ */
+import { onBeforeUnmount, onMounted, watch } from 'vue'
+import { getAccessToken } from '@/utils/auth'
+import { service } from '@/config/axios/service'
+import { activeReachAiPage, type ReachAiPageBridge } from './pageBinding'
+
+defineOptions({ name: 'ReachAiChat' })
+
+interface ReachAiChatClient {
+  destroy(): void
+}
+interface ReachAiGlobal {
+  createEafChat(options: Record<string, unknown>): Promise<ReachAiChatClient>
+  createEafPageBridge(options: Record<string, unknown>): ReachAiPageBridge
+}
+
+const reachAiBase = (import.meta.env.VITE_REACHAI_BASE_URL || '').replace(/\/+$/, '')
+const agentId = import.meta.env.VITE_REACHAI_AGENT_ID || ''
+// 默认使用业务后端；独立本地测试后端可显式指定其令牌端点。
+const tokenUrl =
+  import.meta.env.VITE_REACHAI_TOKEN_URL ||
+  `${import.meta.env.VITE_BASE_URL || ''}/reachai/embed/token`
+const SCRIPT_ID = 'reachai-chat-embed-sdk'
+
+let client: ReachAiChatClient | null = null
+let mountEl: HTMLElement | null = null
+let disposed = false
+let generation = 0
+let sdkPromise: Promise<ReachAiGlobal> | undefined
+const route = useRoute()
+
+const loadSdk = (): Promise<ReachAiGlobal> => {
+  const existing = (window as unknown as { ReachAI?: ReachAiGlobal }).ReachAI
+  if (existing) return Promise.resolve(existing)
+  if (sdkPromise) return sdkPromise
+  const pending = new Promise<ReachAiGlobal>((resolve, reject) => {
+    if (!document.getElementById(`${SCRIPT_ID}-css`)) {
+      const link = document.createElement('link')
+      link.id = `${SCRIPT_ID}-css`
+      link.rel = 'stylesheet'
+      link.href = `${reachAiBase}/sdk/embed-chat/style.css`
+      document.head.appendChild(link)
+    }
+    const script = document.createElement('script')
+    script.id = SCRIPT_ID
+    script.src = `${reachAiBase}/sdk/embed-chat/reachai-chat-embed.umd.js`
+    script.onload = () => {
+      const loaded = (window as unknown as { ReachAI?: ReachAiGlobal }).ReachAI
+      loaded ? resolve(loaded) : reject(new Error('ReachAI SDK 未加载'))
+    }
+    script.onerror = () => {
+      script.remove()
+      reject(new Error('ReachAI SDK 加载失败'))
+    }
+    document.head.appendChild(script)
+  }).catch((error) => {
+    sdkPromise = undefined
+    throw error
+  })
+  sdkPromise = pending
+  return pending
+}
+
+const fetchToken = async (context: Record<string, unknown> = {}) => {
+  const { signal, ...page } = context as { signal?: AbortSignal } & Record<string, unknown>
+  const payload = (await service({
+    url: tokenUrl,
+    baseURL: '',
+    method: 'POST',
+    signal,
+    headers: { 'Content-Type': 'application/json' },
+    validateStatus: (status) => (status >= 200 && status < 300) || status === 401,
+    data: { ...page, agentId }
+  })) as unknown as { token?: string; expiresIn?: number; message?: string }
+  if (!payload?.token) throw new Error(payload?.message || '获取对话令牌失败')
+  return { token: payload.token as string, expiresIn: payload.expiresIn as number }
+}
+
+const mountChat = async () => {
+  const currentGeneration = ++generation
+  client?.destroy()
+  client = null
+  mountEl?.remove()
+  mountEl = null
+  if (!reachAiBase || !agentId || !getAccessToken()) return
+  const binding = activeReachAiPage.value?.route === route.path ? activeReachAiPage.value : null
+  let localMount: HTMLElement | null = null
+  try {
+    const sdk = await loadSdk()
+    if (disposed || currentGeneration !== generation) return
+    const bridge = sdk.createEafPageBridge({ route: route.path })
+    binding?.registerActions(bridge)
+    localMount = document.createElement('div')
+    mountEl = localMount
+    document.body.appendChild(localMount)
+    const created = await sdk.createEafChat({
+      mount: localMount,
+      agentId,
+      apiBase: reachAiBase,
+      position: 'bottom-right',
+      locale: 'zh-CN',
+      // 目标环境完成业务系统隔离升级与验收前，先隐藏个人记忆入口。
+      memories: false,
+      bridge,
+      ...(binding ? {
+        page: { pageKey: binding.pageKey, name: binding.name, routePattern: binding.route },
+        pageRegistry: {}
+      } : {}),
+      tokenProvider: fetchToken
+    })
+    if (disposed || currentGeneration !== generation) {
+      created.destroy()
+      localMount.remove()
+      return
+    }
+    client = created
+  } catch (error) {
+    localMount?.remove()
+    if (mountEl === localMount) mountEl = null
+    if (!disposed && currentGeneration === generation) console.warn('[ReachAI] 嵌入式对话初始化失败', error)
+  }
+}
+
+onMounted(() => {
+  watch([() => route.path, activeReachAiPage], () => void mountChat(), { immediate: true })
+})
+
+onBeforeUnmount(() => {
+  disposed = true
+  generation++
+  client?.destroy()
+  client = null
+  mountEl?.remove()
+  mountEl = null
+})
+</script>
+
+<template>
+  <span hidden aria-hidden="true"></span>
+</template>
diff --git a/src/layout/components/ReachAiChat/pageBinding.ts b/src/layout/components/ReachAiChat/pageBinding.ts
