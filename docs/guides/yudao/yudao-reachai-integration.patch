+/**
+ * 嵌入式对话换取 ReachAI 嵌入令牌时，把当前登录的芋道用户交给 ReachAI。
+ *
+ * <p>Starter 据此暴露 {@code POST /reachai/embed/token}。{@code /reachai/**} 在芋道里是 permitAll，
+ * 但芋道的令牌过滤器仍会解析请求里的 {@code Authorization}，所以这里能拿到登录用户；未登录返回 null，Starter 回 401。
+ * 角色编码用于 ReachAI 的「调用权限」。</p>
+ */
+public class YudaoReachAiEmbedPrincipalResolver implements ReachAiEmbedPrincipalResolver {
+
+    private final AdminUserService adminUserService;
+    private final PermissionService permissionService;
+    private final RoleService roleService;
+    private final TenantFrameworkService tenantFrameworkService;
+    private final YudaoReachAiBusinessSession businessSession;
+
+    public YudaoReachAiEmbedPrincipalResolver(AdminUserService adminUserService,
+                                              PermissionService permissionService,
+                                              RoleService roleService,
+                                              TenantFrameworkService tenantFrameworkService,
+                                              YudaoReachAiBusinessSession businessSession) {
+        this.adminUserService = adminUserService;
+        this.permissionService = permissionService;
+        this.roleService = roleService;
+        this.tenantFrameworkService = tenantFrameworkService;
+        this.businessSession = businessSession;
+    }
+
+    @Override
+    public ReachAiEmbedPrincipal resolve(String agentId) {
+        LoginUser loginUser = SecurityFrameworkUtils.getLoginUser();
+        if (loginUser == null || loginUser.getId() == null || loginUser.getTenantId() == null
+                || !UserTypeEnum.ADMIN.getValue().equals(loginUser.getUserType())) {
+            return null;
+        }
+        tenantFrameworkService.validTenant(loginUser.getTenantId());
+        YudaoReachAiBusinessSession.Session session = businessSession.resolve(loginUser);
+        if (session == null) return null;
+        return TenantUtils.execute(loginUser.getTenantId(), () -> {
+            AdminUserDO user = adminUserService.getUser(loginUser.getId());
+            if (user == null || !CommonStatusEnum.ENABLE.getStatus().equals(user.getStatus())) {
+                return null;
+            }
+            Map<String, Object> attributes = new HashMap<>();
+            attributes.put("tenantId", String.valueOf(loginUser.getTenantId()));
+            attributes.put("nickname", user.getNickname());
+            attributes.put("username", user.getUsername());
+            String userId = String.valueOf(user.getId());
+            String displayName = StrUtil.isNotBlank(user.getNickname()) ? user.getNickname() : user.getUsername();
+            return new ReachAiEmbedPrincipal(userId, userId, displayName, roleCodes(user.getId()), attributes,
+                    session.getId(), session.getExpiresAt());
+        });
+    }
+
+    private List<String> roleCodes(Long userId) {
+        Set<Long> roleIds = permissionService.getUserRoleIdListByUserIdFromCache(userId);
+        if (CollUtil.isEmpty(roleIds)) {
+            return Collections.emptyList();
+        }
+        return roleService.getRoleListFromCache(roleIds).stream()
+                .filter(role -> CommonStatusEnum.ENABLE.getStatus().equals(role.getStatus()))
+                .map(RoleDO::getCode)
+                .collect(Collectors.toList());
+    }
+
+}
