@@ -0,0 +1,55 @@
+package cn.iocoder.yudao.server.reachai;
+
+import cn.iocoder.yudao.framework.common.enums.UserTypeEnum;
+import cn.iocoder.yudao.module.system.dal.dataobject.oauth2.OAuth2AccessTokenDO;
+import cn.iocoder.yudao.module.system.service.oauth2.OAuth2SessionRemovalListener;
+import com.enterprise.ai.reach.spring.ReachAiEmbedTokenClient;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.scheduling.annotation.Scheduled;
+
+import java.sql.Timestamp;
+import java.time.Instant;
+import java.util.List;
+
+/** Transactional logout notification; only opaque session hashes enter the outbox. */
+public class YudaoReachAiLogoutOutbox implements OAuth2SessionRemovalListener {
+    private static final Logger log = LoggerFactory.getLogger(YudaoReachAiLogoutOutbox.class);
+    private final JdbcTemplate jdbc;
+    private final ReachAiEmbedTokenClient client;
+
+    public YudaoReachAiLogoutOutbox(JdbcTemplate jdbc, ReachAiEmbedTokenClient client) {
+        this.jdbc = jdbc;
+        this.client = client;
+    }
+
+    @Override
+    public void beforeRemoval(OAuth2AccessTokenDO token) {
+        if (token == null || !UserTypeEnum.ADMIN.getValue().equals(token.getUserType())) return;
+        String id = YudaoReachAiBusinessSession.fromRefreshToken(token.getRefreshToken());
+        if (id == null) return; // Such a session cannot receive a bound Embed Token.
+        jdbc.update("INSERT INTO system_reachai_logout_outbox (session_id, next_attempt_at) VALUES (?, ?) "
+                        + "ON DUPLICATE KEY UPDATE session_id = VALUES(session_id)",
+                id, Timestamp.from(Instant.now()));
+    }
+
+    @Scheduled(fixedDelayString = "${reachai.logout-revocation.retry-delay-ms:2000}")
+    public void deliverPending() {
+        List<String> pending = jdbc.query("SELECT session_id FROM system_reachai_logout_outbox "
+                        + "WHERE next_attempt_at <= ? ORDER BY next_attempt_at, id LIMIT 20",
+                (rs, row) -> rs.getString(1), Timestamp.from(Instant.now()));
+        for (String id : pending) {
+            try {
+                client.revokeBusinessSession(id);
+                jdbc.update("DELETE FROM system_reachai_logout_outbox WHERE session_id = ?", id);
+            } catch (RuntimeException failure) {
+                // No token, session identifier, response body, or credential in the log.
+                log.warn("ReachAI logout notification failed; it will be retried");
+                jdbc.update("UPDATE system_reachai_logout_outbox SET attempts = attempts + 1, "
+                                + "next_attempt_at = ? WHERE session_id = ?",
+                        Timestamp.from(Instant.now().plusSeconds(30)), id);
+            }
+        }
+    }
+}
