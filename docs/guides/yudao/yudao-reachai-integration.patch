--- /dev/null
+++ b/yudao-server/src/main/java/cn/iocoder/yudao/server/reachai/YudaoReachAiConfiguration.java
@@ -0,0 +1,40 @@
+package cn.iocoder.yudao.server.reachai;
+
+import cn.iocoder.yudao.framework.security.config.AuthorizeRequestsCustomizer;
+import cn.iocoder.yudao.module.system.service.user.AdminUserService;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnClass;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.security.config.annotation.web.builders.HttpSecurity;
+import org.springframework.security.config.annotation.web.configurers.AuthorizeHttpRequestsConfigurer;
+
+/**
+ * ReachAI 接入配置。
+ *
+ * <p>{@code /reachai/**} 由 ReachAI Starter 自己校验项目签名和调用令牌，因此在芋道的登录拦截里放行；
+ * 业务调用的身份和租户由 {@link YudaoReachAiSecurityBridge} 建立。</p>
+ */
+@Configuration(proxyBeanMethods = false)
+@ConditionalOnClass(name = "com.enterprise.ai.reach.spring.ReachAiSecurityContextBridge")
+public class YudaoReachAiConfiguration {
+
+    @Bean("reachAiAuthorizeRequestsCustomizer")
+    public AuthorizeRequestsCustomizer reachAiAuthorizeRequestsCustomizer() {
+        return new AuthorizeRequestsCustomizer() {
+            @Override
+            public void customize(AuthorizeHttpRequestsConfigurer<HttpSecurity>.AuthorizationManagerRequestMatcherRegistry registry) {
+                registry.requestMatchers("/reachai/**").permitAll();
+            }
+        };
+    }
+
+    @Bean
+    public YudaoReachAiSecurityBridge yudaoReachAiSecurityBridge(
+            AdminUserService adminUserService,
+            @Value("${yudao.reachai.default-tenant-id:1}") Long defaultTenantId,
+            @Value("${yudao.reachai.default-user-id:}") Long defaultUserId) {
+        return new YudaoReachAiSecurityBridge(adminUserService, defaultTenantId, defaultUserId);
+    }
+
+}
diff --git a/yudao-server/src/main/java/cn/iocoder/yudao/server/reachai/YudaoReachAiSecurityBridge.java b/yudao-server/src/main/java/cn/iocoder/yudao/server/reachai/YudaoReachAiSecurityBridge.java
new file mode 100644
index 0000000..fedc0e8
--- /dev/null
+++ b/yudao-server/src/main/java/cn/iocoder/yudao/server/reachai/YudaoReachAiSecurityBridge.java
@@ -0,0 +1,98 @@
+package cn.iocoder.yudao.server.reachai;
+
+import cn.hutool.core.util.NumberUtil;
+import cn.hutool.core.util.StrUtil;
+import cn.iocoder.yudao.framework.common.enums.CommonStatusEnum;
+import cn.iocoder.yudao.framework.common.enums.UserTypeEnum;
+import cn.iocoder.yudao.framework.security.core.LoginUser;
+import cn.iocoder.yudao.framework.tenant.core.context.TenantContextHolder;
+import cn.iocoder.yudao.framework.tenant.core.util.TenantUtils;
+import cn.iocoder.yudao.module.system.dal.dataobject.user.AdminUserDO;
+import cn.iocoder.yudao.module.system.service.user.AdminUserService;
+import com.enterprise.ai.reach.spring.ReachAiInvocationContext;
+import com.enterprise.ai.reach.spring.ReachAiSecurityContextBridge;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.core.context.SecurityContext;
+import org.springframework.security.core.context.SecurityContextHolder;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * 把 ReachAI 已验签的调用身份映射为芋道的租户和登录用户，让 {@code @PreAuthorize}、数据权限和多租户插件照常生效。
+ *
+ * <p>用户映射顺序：调用令牌里的外部用户编号（芋道用户 id）→ 同名芋道账号 → 配置的默认服务账号。
+ * 都找不到时拒绝调用，而不是匿名执行。</p>
+ */
+@Slf4j
+public class YudaoReachAiSecurityBridge implements ReachAiSecurityContextBridge {
+
+    private final AdminUserService adminUserService;
+    private final Long defaultTenantId;
+    private final Long defaultUserId;
+
+    public YudaoReachAiSecurityBridge(AdminUserService adminUserService, Long defaultTenantId, Long defaultUserId) {
+        this.adminUserService = adminUserService;
+        this.defaultTenantId = defaultTenantId;
+        this.defaultUserId = defaultUserId;
+    }
+
+    @Override
+    public Object runWith(ReachAiInvocationContext context, Invocation invocation) throws Exception {
+        Long tenantId = NumberUtil.isLong(context.getTenantId()) ? Long.valueOf(context.getTenantId()) : defaultTenantId;
+        // 用户查询本身也受多租户约束，所以在目标租户内解析
+        AdminUserDO user = TenantUtils.execute(tenantId, () -> resolveUser(context));
+        if (user == null || !CommonStatusEnum.ENABLE.getStatus().equals(user.getStatus())) {
+            throw new IllegalStateException("ReachAI 调用无法映射到可用的芋道用户");
+        }
+        LoginUser loginUser = new LoginUser().setId(user.getId()).setUserType(UserTypeEnum.ADMIN.getValue())
+                .setTenantId(tenantId).setInfo(buildInfo(user)).setScopes(Collections.emptyList());
+
+        Long oldTenantId = TenantContextHolder.getTenantId();
+        Boolean oldIgnore = TenantContextHolder.isIgnore();
+        SecurityContext oldSecurityContext = SecurityContextHolder.getContext();
+        try {
+            TenantContextHolder.setTenantId(tenantId);
+            TenantContextHolder.setIgnore(false);
+            SecurityContext securityContext = SecurityContextHolder.createEmptyContext();
+            securityContext.setAuthentication(new UsernamePasswordAuthenticationToken(loginUser, null, Collections.emptyList()));
+            SecurityContextHolder.setContext(securityContext);
+            log.info("[ReachAI] capability={} agent={} trace={} -> yudao user={} tenant={}",
+                    context.getCapabilityName(), context.getAgentId(), context.getTraceId(), user.getId(), tenantId);
+            return invocation.proceed();
+        } finally {
+            SecurityContextHolder.setContext(oldSecurityContext);
+            TenantContextHolder.setTenantId(oldTenantId);
+            TenantContextHolder.setIgnore(oldIgnore);
+        }
+    }
+
+    private AdminUserDO resolveUser(ReachAiInvocationContext context) {
+        String externalUserId = context.getExternalUserId();
+        if (NumberUtil.isLong(externalUserId)) {
+            AdminUserDO user = adminUserService.getUser(Long.valueOf(externalUserId));
+            if (user != null) {
+                return user;
+            }
+        }
+        for (String username : new String[]{externalUserId, context.getUserName()}) {
+            if (StrUtil.isNotBlank(username)) {
+                AdminUserDO user = adminUserService.getUserByUsername(username);
+                if (user != null) {
+                    return user;
+                }
+            }
+        }
+        return defaultUserId == null ? null : adminUserService.getUser(defaultUserId);
+    }
+
+    private static Map<String, String> buildInfo(AdminUserDO user) {
+        Map<String, String> info = new HashMap<>();
+        info.put(LoginUser.INFO_KEY_NICKNAME, user.getNickname());
+        info.put(LoginUser.INFO_KEY_DEPT_ID, StrUtil.toStringOrNull(user.getDeptId()));
+        return info;
+    }
+
+}
