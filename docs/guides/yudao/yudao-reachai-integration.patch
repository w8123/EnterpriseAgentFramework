+package cn.iocoder.yudao.server.reachai;
+
+import cn.hutool.core.util.StrUtil;
+import cn.hutool.crypto.digest.DigestUtil;
+import cn.iocoder.yudao.framework.common.exception.ServiceException;
+import cn.iocoder.yudao.framework.common.util.servlet.ServletUtils;
+import cn.iocoder.yudao.framework.security.config.SecurityProperties;
+import cn.iocoder.yudao.framework.security.core.LoginUser;
+import cn.iocoder.yudao.framework.security.core.util.SecurityFrameworkUtils;
+import cn.iocoder.yudao.module.system.dal.dataobject.oauth2.OAuth2AccessTokenDO;
+import cn.iocoder.yudao.module.system.service.oauth2.OAuth2TokenService;
+
+import javax.servlet.http.HttpServletRequest;
+import java.time.Instant;
+import java.time.ZoneId;
+import java.util.Objects;
+
+/** Derives a stable, opaque identifier from a verified host login session. */
+public class YudaoReachAiBusinessSession {
+    private final OAuth2TokenService tokens;
+    private final SecurityProperties security;
+
+    public YudaoReachAiBusinessSession(OAuth2TokenService tokens, SecurityProperties security) {
+        this.tokens = tokens;
+        this.security = security;
+    }
+
+    public Session resolve(LoginUser user) {
+        HttpServletRequest request = ServletUtils.getRequest();
+        if (request == null || user == null) return null;
+        String accessToken = SecurityFrameworkUtils.obtainAuthorization(request,
+                security.getTokenHeader(), security.getTokenParameter());
+        if (StrUtil.isBlank(accessToken)) return null;
+        OAuth2AccessTokenDO token;
+        try {
+            token = tokens.checkAccessToken(accessToken);
+        } catch (ServiceException invalid) {
+            return null;
+        }
+        if (token == null || !Objects.equals(token.getUserId(), user.getId())
+                || !Objects.equals(token.getUserType(), user.getUserType())
+                || !Objects.equals(token.getTenantId(), user.getTenantId())) return null;
+        // Yudao also accepts a refresh token as an access token for some legacy
+        // integrations. It must not extend an Embed token to the refresh lifetime.
+        if (Objects.equals(accessToken, token.getRefreshToken())) return null;
+        String id = fromRefreshToken(token.getRefreshToken());
+        if (id == null || token.getExpiresTime() == null) return null;
+        long expiresAt = token.getExpiresTime().atZone(ZoneId.systemDefault()).toEpochSecond();
+        if (expiresAt <= Instant.now().getEpochSecond()) return null;
+        return new Session(id, expiresAt);
+    }
+
+    public static String fromRefreshToken(String refreshToken) {
+        if (StrUtil.isBlank(refreshToken)) return null;
+        return DigestUtil.sha256Hex("reachai-yudao-session-v1:" + refreshToken);
+    }
+
+    public static final class Session {
+        private final String id;
+        private final long expiresAt;
+        public Session(String id, long expiresAt) { this.id = id; this.expiresAt = expiresAt; }
+        public String getId() { return id; }
+        public long getExpiresAt() { return expiresAt; }
+    }
+}
