diff --git a/sql/mysql/reachai-logout-outbox.sql b/sql/mysql/reachai-logout-outbox.sql
new file mode 100644
index 0000000..567a6fc
--- /dev/null
+++ b/sql/mysql/reachai-logout-outbox.sql
@@ -0,0 +1,12 @@
+-- 芋道 ReachAI 退出通知队列；执行前备份并核对目标库。
+-- 只有完成该表及 ReachAI 服务端升级后，才启用 reachai.logout-revocation.enabled。
+CREATE TABLE IF NOT EXISTS `system_reachai_logout_outbox` (
+  `id` BIGINT NOT NULL AUTO_INCREMENT,
+  `session_id` CHAR(64) NOT NULL COMMENT '不可逆业务会话标识',
+  `attempts` INT NOT NULL DEFAULT 0,
+  `next_attempt_at` DATETIME(3) NOT NULL,
+  `created_at` DATETIME(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3),
+  PRIMARY KEY (`id`),
+  UNIQUE KEY `uk_reachai_logout_session` (`session_id`),
+  KEY `idx_reachai_logout_next` (`next_attempt_at`, `id`)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='ReachAI 退出撤销通知';
