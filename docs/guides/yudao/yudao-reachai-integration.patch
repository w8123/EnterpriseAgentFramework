+package cn.iocoder.yudao.server.reachai;
+
+import cn.iocoder.yudao.framework.security.config.AuthorizeRequestsCustomizer;
+import cn.iocoder.yudao.framework.security.config.SecurityProperties;
+import cn.iocoder.yudao.framework.tenant.core.service.TenantFrameworkService;
+import cn.iocoder.yudao.module.system.service.permission.PermissionService;
+import cn.iocoder.yudao.module.system.service.permission.RoleService;
+import cn.iocoder.yudao.module.system.service.user.AdminUserService;
+import cn.iocoder.yudao.module.system.service.oauth2.OAuth2TokenService;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnClass;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.security.config.annotation.web.builders.HttpSecurity;
+import org.springframework.security.config.annotation.web.configurers.AuthorizeHttpRequestsConfigurer;
+
+/**
+ * ReachAI 接入配置。
+ *
+ * <p>{@code /reachai/**} 由 ReachAI Starter 自己校验项目签名和调用令牌，因此在芋道的登录拦截里放行；
+ * 业务调用的身份和租户由 {@link YudaoReachAiSecurityBridge} 建立。</p>
+ */
+@Configuration(proxyBeanMethods = false)
+@ConditionalOnClass(name = "com.enterprise.ai.reach.spring.ReachAiSecurityContextBridge")
+public class YudaoReachAiConfiguration {
+
+    @Bean("reachAiAuthorizeRequestsCustomizer")
+    public AuthorizeRequestsCustomizer reachAiAuthorizeRequestsCustomizer() {
+        return new AuthorizeRequestsCustomizer() {
+            @Override
+            public void customize(AuthorizeHttpRequestsConfigurer<HttpSecurity>.AuthorizationManagerRequestMatcherRegistry registry) {
+                registry.requestMatchers("/reachai/**").permitAll();
+            }
+        };
+    }
+
+    @Bean
+    public YudaoReachAiSecurityBridge yudaoReachAiSecurityBridge(AdminUserService adminUserService,
+                                                                TenantFrameworkService tenantFrameworkService) {
+        return new YudaoReachAiSecurityBridge(adminUserService, tenantFrameworkService);
+    }
+
+    /** 提供后 Starter 自动暴露 POST /reachai/embed/token，供嵌入式对话用当前登录用户换取令牌。 */
+    @Bean
+    public YudaoReachAiBusinessSession yudaoReachAiBusinessSession(
+            OAuth2TokenService tokens, SecurityProperties security) {
+        return new YudaoReachAiBusinessSession(tokens, security);
+    }
+
+    @Bean
+    public YudaoReachAiEmbedPrincipalResolver yudaoReachAiEmbedPrincipalResolver(
+            AdminUserService adminUserService, PermissionService permissionService, RoleService roleService,
+            TenantFrameworkService tenantFrameworkService, YudaoReachAiBusinessSession businessSession) {
+        return new YudaoReachAiEmbedPrincipalResolver(adminUserService, permissionService, roleService, tenantFrameworkService, businessSession);
+    }
+
+}
