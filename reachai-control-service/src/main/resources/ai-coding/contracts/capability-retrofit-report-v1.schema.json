{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reachai:ai-coding:capability-retrofit-report:v1",
  "title": "ReachAI Capability Retrofit Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "summary",
    "selectionQuestionId",
    "mode",
    "capabilities",
    "changedFiles",
    "tests",
    "sdkSync",
    "remainingQuestions"
  ],
  "properties": {
    "schema": {
      "const": "reachai.capability-retrofit-report.v1"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "selectionQuestionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "mode": {
      "type": "string",
      "enum": [
        "SDK_DECLARATION",
        "OPENAPI_IMPORT"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "delivery-evidence-v1.schema.json#/$defs/check"
      }
    },
    "sdkSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "message"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "remainingQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateKey",
        "name",
        "title",
        "sideEffect",
        "sourceFile",
        "status"
      ],
      "properties": {
        "candidateKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sideEffect": {
          "type": "string",
          "enum": [
            "READ",
            "WRITE",
            "IRREVERSIBLE"
          ]
        },
        "sourceFile": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "DECLARED",
            "SKIPPED"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
