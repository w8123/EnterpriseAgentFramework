{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reachai:ai-coding:browser-acceptance-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passed",
    "summary",
    "checks",
    "browserVerification",
    "structuredPresentation",
    "stateRestoration"
  ],
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "delivery-evidence-v1.schema.json#/$defs/check"
      }
    },
    "browserVerification": {
      "$ref": "delivery-evidence-v1.schema.json#/$defs/browserVerification"
    },
    "structuredPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "passed",
        "uiRequestedObserved",
        "cardDomObserved",
        "component",
        "evidence"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "uiRequestedObserved": {
          "type": "boolean"
        },
        "cardDomObserved": {
          "type": "boolean"
        },
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stateRestoration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "passed",
        "evidence"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "passed": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
