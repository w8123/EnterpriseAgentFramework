{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reachai:ai-coding:browser-acceptance-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "passed",
    "summary",
    "checks",
    "browserVerification"
  ],
  "properties": {
    "passed": {
      "type": "boolean"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "delivery-evidence-v1.schema.json#/$defs/check"
      }
    },
    "browserVerification": {
      "$ref": "delivery-evidence-v1.schema.json#/$defs/browserVerification"
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
