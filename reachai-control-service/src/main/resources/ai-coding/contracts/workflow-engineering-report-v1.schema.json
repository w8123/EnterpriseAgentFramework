{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reachai:ai-coding:workflow-engineering-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageKey",
    "summary",
    "workflow",
    "selectedActionKeys",
    "referencedFiles",
    "acceptanceCriteria",
    "remainingQuestions"
  ],
  "properties": {
    "pageKey": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "keySlug",
        "graphSpec"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "keySlug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 117,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]+$"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "defaultModelInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "graphSpec": {
          "type": "object"
        },
        "canvas": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "selectedActionKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "referencedFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remainingQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
