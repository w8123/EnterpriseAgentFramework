{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reachai:ai-coding:code-implementation-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "changedFiles",
    "tests",
    "browserVerification",
    "remainingQuestions"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "delivery-evidence-v1.schema.json#/$defs/check"
      }
    },
    "browserVerification": {
      "$ref": "delivery-evidence-v1.schema.json#/$defs/browserVerification"
    },
    "workflowId": {
      "type": [
        "string",
        "null"
      ]
    },
    "remainingQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
