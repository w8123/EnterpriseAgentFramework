{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reachai:ai-coding:trace-workflow-candidate-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceTraceId",
    "summary",
    "workflow",
    "acceptanceCriteria",
    "remainingQuestions"
  ],
  "properties": {
    "sourceTraceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "keySlug",
        "workflowKind",
        "graphSpec"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "keySlug": {
          "type": "string",
          "minLength": 2,
          "maxLength": 110,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]+$"
        },
        "description": {
          "type": ["string", "null"],
          "maxLength": 2000
        },
        "workflowKind": {
          "type": "string",
          "enum": ["GENERAL", "RAG"]
        },
        "defaultModelInstanceId": {
          "type": ["string", "null"]
        },
        "graphSpec": {
          "type": "object",
          "required": ["nodes", "edges", "entryNodeId", "exitNodeIds"],
          "properties": {
            "nodes": {
              "type": "array",
              "minItems": 1
            },
            "edges": {
              "type": "array"
            },
            "entryNodeId": {
              "type": "string",
              "minLength": 1
            },
            "exitNodeIds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "canvas": {
          "type": ["object", "null"]
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "remainingQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  }
}
