# ReachAI 正式部署配置（deploy/docker-compose.yml 使用）。
# 用 install.sh 安装时会自动生成这个文件并填好随机密码，一般不用手动改。
# 手动部署：复制成 reachai.env，至少填写下面「需要你填的」三项，然后
#   docker compose --env-file reachai.env up -d
#
# 密钥（内部通信、模型凭据加密等）不用填：首次启动时自动生成在 data/secrets.properties，
# 之后一直复用。请把 data/ 目录和数据库一起备份，丢了以后已保存的模型 API Key 等就解不开了。

# ======================== 需要你填的 ========================

# 管理员 admin 首次登录的密码（只在数据库里还没有这个账号时生效）
REACHAI_BOOTSTRAP_ADMIN_PASSWORD=

# 数据库密码。用自带 MySQL 时这两个随便填一串随机字符即可
AI_MYSQL_PASSWORD=
REACHAI_MYSQL_ROOT_PASSWORD=

# 浏览器访问 ReachAI 的地址。员工把 Codex / Claude Code 连到 ReachAI 时要用，
# 配了域名和 HTTPS 就写 https://reachai.example.com
REACHAI_PUBLIC_URL=http://localhost:8080

# ======================== 按需修改 ========================

# 对外端口；只想让本机 Nginx 反向代理访问时把 REACHAI_BIND 改成 127.0.0.1
REACHAI_PORT=8080
REACHAI_BIND=0.0.0.0

# 要启动的可选组件：mysql（自带 MySQL）、milvus（知识库向量检索）、redis
COMPOSE_PROFILES=mysql

# 用自己的 MySQL 时：COMPOSE_PROFILES 去掉 mysql，再填写下面几项（库需要提前建好，空库即可，表会自动建）
# AI_MYSQL_HOST=192.168.1.10
# AI_MYSQL_PORT=3306
# AI_MYSQL_DATABASE=reach_ai
# AI_MYSQL_USER=reach_ai

# 镜像版本：dev 跟随最新开发版；正式使用建议固定成某个版本号，例如 v0.1.0
REACHAI_VERSION=dev
# 国内拉取 ghcr.io 慢时可以换成镜像加速地址
REACHAI_IMAGE_REGISTRY=ghcr.io/w8123

# 每个服务的 JVM 内存。install.sh 会按机器内存自动设置
# REACHAI_JAVA_OPTS_MODEL=-Xms96m -Xmx384m -XX:+UseSerialGC
# REACHAI_JAVA_OPTS_KNOWLEDGE=-Xms128m -Xmx512m -XX:+UseSerialGC
# REACHAI_JAVA_OPTS_CAPABILITY=-Xms96m -Xmx384m -XX:+UseSerialGC
# REACHAI_JAVA_OPTS_RUNTIME=-Xms128m -Xmx640m -XX:+UseSerialGC
# REACHAI_JAVA_OPTS_CONTROL=-Xms128m -Xmx640m -XX:+UseSerialGC

# ReachAI 要调用内网里的业务系统（如 192.168.x.x）时打开
# RUNTIME_HTTP_EGRESS_ALLOW_PRIVATE=true

# Docling：知识库解析 PDF、Word、PPT、Excel。没装时只能导入 txt / md / csv
# REACHAI_DOCLING_ENABLED=true
# REACHAI_DOCLING_BASE_URL=http://docling:5001
