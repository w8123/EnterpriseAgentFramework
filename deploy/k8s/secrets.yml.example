## 示例：创建 AI 平台所需的 Secret（请勿将真实值提交到 Git）
## 使用方法: kubectl apply -f secrets.yml
##
## REACHAI_INTERNAL_SERVICE_SECRET:
## - Control 与 Runtime 必须使用同一个值
## - 至少 256-bit 随机（例如: openssl rand -hex 32）
## - 轮换后旧签名全部失效，需同时滚动更新两个 Deployment
apiVersion: v1
kind: Secret
metadata:
  name: ai-secrets
type: Opaque
stringData:
  dashscope-api-key: "sk-your-dashscope-key"
  mysql-url: "jdbc:mysql://mysql:3306/reach_ai?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai"
  mysql-user: "root"
  mysql-password: "your-mysql-password"
  # PLACEHOLDER ONLY — replace before apply. Never commit a real value.
  reachai-internal-service-secret: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
  # Docling is ClusterIP-only. Use a dedicated random value rather than a user token.
  docling-api-key: "REPLACE_WITH_OPENSSL_RAND_HEX_32"
  # Shared S3/MinIO document artifact store. Create the bucket and a least-privilege
  # service credential before applying production manifests.
  knowledge-artifact-s3-endpoint: "http://minio:9000"
  knowledge-artifact-s3-access-key: "REPLACE_WITH_ARTIFACT_ACCESS_KEY"
  knowledge-artifact-s3-secret-key: "REPLACE_WITH_ARTIFACT_SECRET_KEY"
  knowledge-artifact-s3-bucket: "reachai-knowledge"
