# 复制为 .env 后按需修改：cp .env.example .env
# 全部可选。不填时用演示默认值，只适合本机体验，不要直接用于生产。

# ---------- 大模型（芋道里的对话面板需要；员工 AI 工具连接不需要）----------
# LLM_PROVIDER 可选：deepseek / openai / tongyi / kimi / zhipu
LLM_PROVIDER=deepseek
LLM_API_KEY=
# 留空时按厂商用默认模型：deepseek-chat / gpt-4.1-mini / qwen-plus / kimi-k2-turbo-preview / glm-4.5-air
LLM_MODEL=
# 走代理或兼容 OpenAI 的其他服务时填写，例如 https://api.deepseek.com
LLM_BASE_URL=

# ---------- 访问地址（不在本机打开时改成服务器地址）----------
# 浏览器访问 ReachAI 和芋道用的地址；芋道页面、员工连接命令里都会用到
REACHAI_PUBLIC_URL=http://localhost:18080
YUDAO_PUBLIC_URL=http://localhost:48080
REACHAI_PORT=18080
YUDAO_PORT=48080
MYSQL_PORT=13306

# ---------- 账号与密钥（演示默认值，公开部署前务必修改）----------
REACHAI_ADMIN_PASSWORD=admin123
MYSQL_ROOT_PASSWORD=reachai_root
REACHAI_DB_PASSWORD=reachai_demo
YUDAO_DB_PASSWORD=yudao_demo
MODEL_CREDENTIAL_SECRET=
AGENT_WORKFLOW_CREDENTIAL_SECRET=
EAF_EMBED_TOKEN_SECRET=
