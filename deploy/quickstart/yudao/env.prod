# 一键体验专用（构建时覆盖芋道前端 .env.prod）
NODE_ENV=production
VITE_DEV=false
# 接口与页面同源，由 yudao-web 的 nginx 转发到芋道后端
VITE_BASE_URL=''
VITE_UPLOAD_TYPE=server
VITE_API_URL=/admin-api
VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false
VITE_COMPRESS=none
VITE_BASE_PATH=/
VITE_OUT_DIR=dist-prod
VITE_APP_CAPTCHA_ENABLE=false
VITE_MALL_H5_DOMAIN='http://mall.yudao.iocoder.cn'
VITE_GOVIEW_URL='http://127.0.0.1:3000'
# 容器启动时由 web-entrypoint.sh 替换成 REACHAI_PUBLIC_URL
VITE_REACHAI_BASE_URL=__REACHAI_PUBLIC_URL__
VITE_REACHAI_AGENT_ID=erp-assistant
